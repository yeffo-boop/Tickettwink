# Copy to .env and fill in. See docs/SETUP.md for how to obtain each value.

# --- Core ---
APP_MODE=sandbox            # sandbox | live — see docs/ARCHITECTURE.md
ENVIRONMENT=development     # development | production
SECRET_KEY=                 # required in live mode — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://tickettwink:CHANGE_ME@localhost:5432/tickettwink_dev
DATABASE_URL_SYNC=postgresql+psycopg2://tickettwink:CHANGE_ME@localhost:5432/tickettwink_dev

# --- Telegram (required for APP_MODE=live) ---
# Create a bot via @BotFather on Telegram: https://core.telegram.org/bots/tutorial
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=    # random string; set the same value when calling setWebhook
TELEGRAM_BOT_USERNAME=

# --- TMDB (required for APP_MODE=live) ---
# API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Showtime provider ---
# No real provider is implemented yet — see app/providers/showtime/base.py
SHOWTIME_PROVIDER=manual

# --- Payments ---
# Venmo has no API for verifying P2P payments — reconciliation is manual.
# See app/providers/payment/base.py
PAYMENT_PROVIDER=venmo_manual
VENMO_HANDLE=@your-venmo-handle

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/tickets

# --- Notifications ---
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_SECONDS=30

# --- Circuit breakers ---
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=120
